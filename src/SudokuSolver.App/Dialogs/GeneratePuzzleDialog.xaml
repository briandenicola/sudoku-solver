<Window x:Class="SudokuSolver.App.Dialogs.GeneratePuzzleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Generate Puzzle"
        Width="480" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="..\Resources\app.ico"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel>
        <materialDesign:ColorZone Mode="PrimaryMid" DockPanel.Dock="Top"
                                  Padding="16,10" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="DiceMultipleOutline"
                                          Width="24" Height="24"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Generate Puzzle" FontSize="18" FontWeight="Medium"
                           VerticalAlignment="Center" />
            </StackPanel>
        </materialDesign:ColorZone>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClick"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        MinWidth="80" Margin="0,0,8,0" />
                <Button Content="Generate" Click="OnGenerateClick"
                        IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        MinWidth="100"
                        materialDesign:ButtonAssist.CornerRadius="6" />
            </StackPanel>
        </Border>

        <materialDesign:Card Margin="16" Padding="20"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <StackPanel>
                <TextBlock Text="Choose a difficulty rating"
                           FontSize="16" FontWeight="Medium"
                           Margin="0,0,0,8" />
                <TextBlock Text="The generated puzzle will target the same 1–5 star rating used after solving."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Margin="0,0,0,16" />

                <ComboBox x:Name="DifficultyComboBox"
                          SelectedValuePath="Tag"
                          SelectedIndex="1"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Difficulty">
                    <ComboBoxItem Tag="1" Content="1 - Beginner" />
                    <ComboBoxItem Tag="2" Content="2 - Easy" />
                    <ComboBoxItem Tag="3" Content="3 - Medium" />
                    <ComboBoxItem Tag="4" Content="4 - Hard" />
                    <ComboBoxItem Tag="5" Content="5 - Expert" />
                </ComboBox>
            </StackPanel>
        </materialDesign:Card>
    </DockPanel>
</Window>
