<UserControl x:Class="SudokuSolver.App.Controls.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SudokuSolver.App.ViewModels"
             xmlns:vision="clr-namespace:SudokuSolver.Vision;assembly=SudokuSolver.Vision">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Data template selector for messages -->
        <DataTemplate x:Key="UserMessageTemplate">
            <Border Margin="0,4,40,4" HorizontalAlignment="Right"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    CornerRadius="12,12,0,12" Padding="12,8" MaxWidth="400">
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                           Foreground="White" FontSize="13" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate">
            <Border Margin="40,4,0,4" HorizontalAlignment="Left"
                    Background="{DynamicResource MaterialDesignToolBarBackground}"
                    CornerRadius="12,12,12,0" Padding="12,8" MaxWidth="400">
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           FontSize="13" LineHeight="20" />
            </Border>
        </DataTemplate>

        <Style x:Key="MessageItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
            <Button DockPanel.Dock="Right"
                    Command="{Binding ClearChatCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Clear Chat">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
            </Button>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CommentQuestionOutline" Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SecondaryHueMidBrush}" />
                <TextBlock Text="Q&amp;A Chat" FontSize="16" FontWeight="Medium"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Input area -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Ask a question about sudoku..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     IsEnabled="{Binding IsChatEnabled}"
                     MaxLength="500">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Command="{Binding SendMessageCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Margin="8,0,0,0" Width="40" Height="40"
                    ToolTip="Send Message (Enter)">
                <materialDesign:PackIcon Kind="Send" />
            </Button>
        </Grid>

        <!-- Messages area -->
        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,1" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <ListBox ItemsSource="{Binding Messages}"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource MessageItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static vision:MessageRole.User}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource UserMessageTemplate}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static vision:MessageRole.Assistant}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource AssistantMessageTemplate}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar IsIndeterminate="True"
                     Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"
                     DockPanel.Dock="Top" Margin="0,0,0,4" Height="2" />
    </DockPanel>
</UserControl>
